+_MAX_FALLITI_DEFAULT = 10  # tentativi falliti per IP in _FALLITI_FINESTRA_S, poi blocco
+_FALLITI_FINESTRA_S = 600.0
+_FALLITI_BLOCCO_S = 900.0
