<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- R7 fetta 2 — ripresa al boot del compito in sottofondo (launchd, Mac).
     All'accesso al Mac lancia UNA volta `python gas.py sottofondo-riprendi` (venv): se un compito in
     sottofondo era a metà quando il Mac si è spento, riparte subito (riprese contate, tetto di
     tempo dalla prima creazione, avviso su Telegram), senza aspettare la prima interazione.
     Aspetta la rete fino a 120 s (GAS_SOTTOFONDO_ATTESA_RETE); senza rete non tocca il compito,
     che riparte alla prima interazione con Gas.
     Niente KeepAlive: non resta acceso. AbandonProcessGroup: il compito ripreso non viene
     chiuso da launchd quando il comando finisce.
     Installazione: sostituisci TUO_UTENTE col tuo nome utente del Mac, poi
       cp ~/Gas/scripts/sottofondo/com.gas.sottofondo.plist ~/Library/LaunchAgents/
       launchctl load ~/Library/LaunchAgents/com.gas.sottofondo.plist
     Toglierlo: launchctl unload ~/Library/LaunchAgents/com.gas.sottofondo.plist && rm quel file.
     Serve ~/Gas/.venv: senza, si ferma con «STOP» nel log (mai il python di sistema).
     Nel log solo l'id e lo stato del compito, mai il testo. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.gas.sottofondo</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-c</string>
    <string>cd "$HOME/Gas" &amp;&amp; { [ -f .venv/bin/activate ] || { echo "STOP: manca ~/Gas/.venv (review #839 R-839-1): niente ripresa col python di sistema"; exit 1; }; } &amp;&amp; source .venv/bin/activate &amp;&amp; exec python gas.py sottofondo-riprendi</string>
  </array>
  <key>RunAtLoad</key>
  <true/>
  <key>AbandonProcessGroup</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/Users/TUO_UTENTE/Library/Logs/gas_sottofondo.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/TUO_UTENTE/Library/Logs/gas_sottofondo.log</string>
</dict>
</plist>
